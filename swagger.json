{
  "openapi": "3.0.0",
  "info": {
    "title": "API",
    "version": "1.0.0",
    "description": "API backend"
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "tags": [
    {
      "name": "Connections",
      "description": "Mutual connection requests and accepted connections (Bearer JWT from /auth/login)"
    },
    {
      "name": "Posts",
      "description": "Social posts with public or connections-only visibility (uses mutual connections)"
    },
    {
      "name": "Metrics",
      "description": "Impressions and basic activity counts (Bearer JWT)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/candidates": {
      "post": {
        "summary": "Create a new candidate profile",
        "tags": [
          "Candidates"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "bio": {
                    "type": "string"
                  },
                  "experience_years": {
                    "type": "number"
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "education": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "work_history": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "certifications": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "linkedin_url": {
                    "type": "string"
                  },
                  "github_url": {
                    "type": "string"
                  },
                  "portfolio_url": {
                    "type": "string"
                  },
                  "availability": {
                    "type": "string",
                    "enum": [
                      "Available",
                      "Not Available",
                      "Open to Offers"
                    ]
                  },
                  "salary_expectation": {
                    "type": "number"
                  },
                  "remote_preference": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all candidates with search and filtering",
        "tags": [
          "Candidates"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            },
            "description": "Search term for name, title, or bio"
          },
          {
            "in": "query",
            "name": "location",
            "schema": {
              "type": "string"
            },
            "description": "Filter by location"
          },
          {
            "in": "query",
            "name": "skills",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated skills to filter by"
          },
          {
            "in": "query",
            "name": "experience_min",
            "schema": {
              "type": "number"
            },
            "description": "Minimum years of experience"
          },
          {
            "in": "query",
            "name": "experience_max",
            "schema": {
              "type": "number"
            },
            "description": "Maximum years of experience"
          },
          {
            "in": "query",
            "name": "availability",
            "schema": {
              "type": "string"
            },
            "description": "Filter by availability status"
          },
          {
            "in": "query",
            "name": "remote_preference",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by remote work preference"
          },
          {
            "in": "query",
            "name": "salary_min",
            "schema": {
              "type": "number"
            },
            "description": "Minimum salary expectation"
          },
          {
            "in": "query",
            "name": "salary_max",
            "schema": {
              "type": "number"
            },
            "description": "Maximum salary expectation"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "description": "Number of results per page"
          }
        ]
      }
    },
    "/api/candidates/{id}": {
      "get": {
