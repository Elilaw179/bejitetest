    "/api/job-board/jobs": {
      "post": {
        "summary": "Create a new job posting (image payload)",
        "tags": [
          "JobBoard"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "job_title": {
                    "type": "string",
                    "description": "JOB TITLE (e.g. Graphics Design)"
                  },
                  "industry_sector": {
                    "type": "string",
                    "description": "INDUSTRY / SECTOR (e.g. Health Sector)"
                  },
                  "preferred_country": {
                    "type": "string",
                    "description": "PREFERRED COUNTRY (e.g. Nigeria)"
                  },
                  "preferred_state": {
                    "type": "string",
                    "description": "PREFERRED STATE (e.g. Anambra)"
                  },
                  "work_type": {
                    "type": "string",
                    "enum": [
                      "Full-time",
                      "Part-time",
                      "Contract",
                      "Internship"
                    ]
                  },
                  "expected_salary": {
                    "type": "string",
                    "description": "e.g. N150,000"
                  },
                  "currency": {
                    "type": "string",
                    "description": "e.g. NGN"
                  },
                  "remote_preference": {
                    "type": "string",
                    "enum": [
                      "Remote",
                      "On-site",
                      "Hybrid"
                    ]
                  },
                  "availability": {
                    "type": "string",
                    "description": "e.g. Immediately"
                  },
                  "posted_by": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all jobs with search and filtering (image payload fields)",
